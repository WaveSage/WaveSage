# Local / Capacitor
CAPACITOR_SERVER_URL=http://192.168.1.67:3000

# Required in production (cookie signing). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional — enables OpenAI-backed Sage replies (templates work without it)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional default break (used only when no spot is selected)
# DEFAULT_LAT=33.862
# DEFAULT_LNG=-118.399
# DEFAULT_SPOT_NAME=Hermosa Beach
# DEFAULT_SHORE_BEARING=270

# Production hosts with a persistent volume (Render disk, Railway volume, Fly volume)
# WAVESAGE_DATA_DIR=/data
